# Copy to web/.env and fill in. Never commit web/.env.
#
# Everything in a Vite frontend build is public: these values ship inside the
# JavaScript the browser downloads. Only put configuration here that is safe
# to publish. An Auth0 client secret, a Management API token, or an AWS
# access key in this file is a leaked credential, not a setting.

# --- control plane (from the CDK stack outputs, after `npx cdk deploy`) -----
VITE_API_URL=https://xxxxxxxx.execute-api.us-west-2.amazonaws.com
VITE_WS_URL=wss://xxxxxxxx.execute-api.us-west-2.amazonaws.com/live
VITE_REGION=us-west-2

# --- Auth0 (console sign-in) -----------------------------------------------
# The only application identity provider. Domain and audience must match
# config/auth0.json — that file is what the CDK authorizer and the Lambda
# AUTH0_DOMAIN / AUTH0_AUDIENCE environment are synthesized from. The SPA
# SDK wants the tenant domain, not the /api/v2/ Management API URL.
VITE_AUTH0_DOMAIN=dev-msijboy7a85k3chd.us.auth0.com

# From Auth0 Dashboard -> Applications -> your SPA -> Settings -> Client ID.
# Public by design; it identifies the app, it does not authorize anything.
# Placeholder on purpose: do not commit a live client id here.
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# The identifier of the Auth0 API that protects AmazAI's backend. The API
# rejects access tokens minted for any other audience.
VITE_AUTH0_AUDIENCE=https://api.amazai.co

# --- owner-only seam -------------------------------------------------------
# Restricts the console UI to one identity. `sub` wins over email, because an
# email can be re-registered and a subject cannot. Leave both blank to allow
# any authenticated user. This gates the interface only — the API must do its
# own check server-side.
#
# For the admin@amazai.co bootstrap, set VITE_OWNER_EMAIL so the console shows
# the owner surface to that identity (the server-side twin, OWNER_EMAILS /
# OWNER_SUBJECTS, lives in the root .env.example and gates the API). This is
# not a password: admin@amazai.co's password is set by the human in Auth0 at
# first login and is never stored in this repo (see docs/ADMIN_BOOTSTRAP.md).
VITE_OWNER_SUB=
# VITE_OWNER_EMAIL=admin@amazai.co
VITE_OWNER_EMAIL=
